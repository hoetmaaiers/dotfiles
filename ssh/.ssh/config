Include /Users/robin/.colima/ssh_config

# Using OpenSSH defaults, first assigned value per keyword wins, so specific hosts must come before Host *

###################################################################################
# Marvin cluster tunnels (most specific first)
Host marvin-cluster
  ProxyCommand ssh -T -q %r@login.marvin.vito.local setuptunnel
  ForwardX11 no
  RequestTTY force

Host marvin-cluster-36GB-16CPU
  ProxyCommand ssh -T -q %r@login.marvin.vito.local setuptunnel --mem 36GB --cpus 16
  ForwardX11 no
  RequestTTY force

Host marvin-cluster-32GB-32CPU-1GPU
  ProxyCommand ssh -T -q %r@login.marvin.vito.local setuptunnel --mem 32GB --cpus 32 -- --gpus-per-node 1
  ForwardX11 no
  RequestTTY force

Host marvin-cluster-r12
  ProxyCommand ssh -T -q %r@r12-login.marvin.vito.local setuptunnel
  ForwardX11 no
  RequestTTY force

Host marvin-cluster*
  ControlMaster auto
  ControlPath ~/.ssh/controlmasters/%r@%h:%p
  ControlPersist 10m

Host s12-hpc* r12-* !*.marvin.vito.local
  HostName %h.marvin.vito.local

Host marvin*
  User houdmeyr
  ForwardAgent yes
  ForwardX11 yes
  StrictHostKeyChecking accept-new
  UserKnownHostsFile /dev/null
  LogLevel ERROR

###################################################################################
# Develop
Host develop
  HostName develop.marvin.vito.local
  User houdmeyr
  ForwardX11 yes

Host develop-admin
  HostName develop.marvin.vito.local
  User adminrh
  ForwardX11 yes

Host login.hpc.int.vito.be
  HostName login.hpc.int.vito.be
  User houdmeyr
  HostKeyAlgorithms +ssh-rsa
  ForwardAgent yes
  StrictHostKeyChecking accept-new
  RequestTTY force

###################################################################################
# Projects
Host terrascope
  HostName uservm.terrascope.be
  Port 39203
  User hoetmaaiers

Host climtim-test climtim-prod urbanclimate-test urbanclimate-prod donaldsononroad zandbakautourbclim zandbakdrieseng12 airflow docs-marvin
  User houdmeyr

Host climtim-test
  HostName climtim-swm01.test.marvin.vito.local

Host climtim-prod
  HostName climtim-swm01.prod.marvin.vito.local

Host urbanclimate-test
  HostName urbanclimate-swm01.test.marvin.vito.local

Host urbanclimate-prod
  HostName urbanclimate-swm01.prod.marvin.vito.local

Host donaldsononroad
  HostName donaldsononroad-swm01.marvin.vito.local

Host zandbakautourbclim zandbakdrieseng12
  HostName zandbakdrieseng12-swm01.marvin.vito.local

