###################################################################################
# Homelab
Host homelab-xcn-ng
  HostName 192.168.1.238
  User root

Host proxmox
  HostName 192.168.1.10
  User root

###################################################################################
# Other
Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

Host git.vito.be
  ForwardX11 no
  RequestTTY no
  WarnWeakCrypto no

# Login hop for setuptunnel ProxyCommand: no multiplexing, no TTY on inner ssh (-T in ProxyCommand)
Host login.marvin.vito.local r12-login.marvin.vito.local
  ControlMaster no
  RequestTTY no

# VITO/Marvin hosts (including aliases using HostName)
Match final host *.marvin.vito.local,*.vito.local,*.vito.be
    User houdmeyr
    ForwardAgent yes
    ForwardX11 yes
    StrictHostKeyChecking accept-new
    UserKnownHostsFile /dev/null
    LogLevel ERROR
    ProxyCommand /usr/bin/nc -x 127.0.0.1:1080 -X 5 %h %p
    ControlMaster auto
    ControlPath ~/.ssh/controlmasters/%r@%h:%p
    ControlPersist 10m
    IPQoS none

# Defaults last: first matching value wins per keyword; specific stanzas above override.
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  IdentityFile ~/.ssh/id_ed25519
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 10
  ServerAliveCountMax 3
  TCPKeepAlive yes
